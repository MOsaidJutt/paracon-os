# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── Auth.js ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=replace-with-32-char-random-string
# Intentionally unset: trustHost (lib/auth.config.ts) detects the origin
# per-request from the incoming Host / X-Forwarded-Host headers instead —
# correct for both plain localhost dev and an ngrok tunnel. Only set this if
# deploying to one fixed, known production domain.
# NEXTAUTH_URL=http://localhost:3000

# ─── Encryption (AES-256-GCM for AI keys at rest) ────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ─── AI (seeds GLOBAL AiSetting row) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Storage (S3-compatible — self-hosted MinIO/VPS volume by default, or ───
# ─── Cloudflare R2; logos, photos, compliance docs, project/tender documents) ─
# Local dev/test: `npm run dev:storage` runs a real local S3-compatible server
# (s3rver) pre-configured for the values below — no MinIO/Docker needed locally.
# MinIO example: STORAGE_ENDPOINT=http://localhost:9000, STORAGE_FORCE_PATH_STYLE=true
# R2 example: STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, STORAGE_FORCE_PATH_STYLE=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=S3RVER
STORAGE_SECRET_ACCESS_KEY=S3RVER
STORAGE_BUCKET=oneparacon
STORAGE_FORCE_PATH_STYLE=true
# Public base URL for assets we serve unauthenticated (logos, worker photos) — NOT used for documents (signed URLs only)
STORAGE_PUBLIC_URL=http://localhost:9000/oneparacon

# ─── Inngest (background jobs — nightly compliance recompute, etc.) ─────────
# Optional locally: `npx inngest-cli dev` runs keyless against http://localhost:3000/api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Email (Resend — user invites) ───────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=OneParacon <onboarding@paracon.com.au>

# ─── App URL (used to build accept-invite links) ─────────────────────────────
APP_URL=http://localhost:3000
# Client-readable mirror of APP_URL — set to the current ngrok/tunnel URL when
# demoing so client-side redirects (e.g. sign-out) never fall back to a stale
# local port. Leave unset for plain localhost dev or a fixed production domain.
NEXT_PUBLIC_APP_URL=

# ─── Google Drive (large CAD/drawing sets only — the one deliberate live ────
# ─── integration; everything else stays in our own storage above) ───────────
# From Google Cloud Console: a project with the Drive API + Picker API
# enabled, an OAuth consent screen (Internal if the org has Google Workspace,
# else External + test users) requesting only the drive.file scope, and a Web
# application OAuth client. Leave all four unset to keep the feature hidden —
# the Documents panel falls back to the original manual paste-a-link flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client — update
# this (and the Console entry) whenever the demo tunnel URL changes.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin/google-drive/callback
# Client-readable — used by the Google Picker widget in the browser. Restrict
# it to the Picker API + your domain(s) in Console.
NEXT_PUBLIC_GOOGLE_API_KEY=

# ─── Feature flags (OFF = hidden, but not deleted) ───────────────────────────
FEATURE_AI=false
FEATURE_SUPER_ADMIN=false
