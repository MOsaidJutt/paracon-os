generator client {
  provider = "prisma-client-js"
}

// TEMPORARY: swapped to sqlite for a local client demo with zero external setup.
// Swap back to postgresql + DATABASE_URL_UNPOOLED before continuing real development.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

model Organisation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String?  @default("#B08D57")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  roles               Role[]
  aiSettings          AiSetting[]
  aiUsageLogs         AiUsageLog[]
  organisationModules OrganisationModule[]
  auditLogs           AuditLog[]
  invites             Invite[]
  configs             Config[]
  clients             Client[]
  suppliers           Supplier[]
  tenders             Tender[]
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  hashedPassword String
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditLogs   AuditLog[]
  sentInvites Invite[]

  @@unique([organisationId, email])
  @@index([roleId])
}

model Role {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users           User[]
  rolePermissions RolePermission[]
  invites         Invite[]

  @@unique([organisationId, slug])
}

model Permission {
  id          String @id @default(cuid())
  slug        String @unique
  group       String
  label       String
  description String @default("")

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invite {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email           String
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  invitedByUserId String
  invitedBy       User         @relation(fields: [invitedByUserId], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([organisationId, email])
  @@index([roleId])
}

// ─── AI Configuration ─────────────────────────────────────────────────────────

enum AiScope {
  GLOBAL
  ORG
  FEATURE
}

model AiSetting {
  id                 String        @id @default(cuid())
  scope              AiScope       @default(GLOBAL)
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  feature            String?
  provider           String        @default("openai")
  model              String        @default("gpt-4o-mini")
  apiKeyEncrypted    String
  baseUrl            String?
  temperature        Float         @default(0.7)
  maxTokens          Int           @default(2000)
  enabled            Boolean       @default(true)
  monthlySpendCapUsd Float?
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organisationId])
  @@index([scope, organisationId, feature])
}

model AiUsageLog {
  id               String        @id @default(cuid())
  organisationId   String?
  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  feature          String
  provider         String
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  costEstimateUsd  Float         @default(0)
  latencyMs        Int           @default(0)
  success          Boolean       @default(true)
  error            String?
  createdAt        DateTime      @default(now())

  @@index([organisationId])
  @@index([createdAt])
}

// ─── Modules / Feature Flags ─────────────────────────────────────────────────

model Module {
  id               String  @id @default(cuid())
  slug             String  @unique
  label            String
  description      String  @default("")
  enabledByDefault Boolean @default(true)
  isSystem         Boolean @default(false)
  sortOrder        Int     @default(0)

  organisationModules OrganisationModule[]
}

model OrganisationModule {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)

  @@id([organisationId, moduleId])
}

// ─── Settings Registry ───────────────────────────────────────────────────────

enum ConfigType {
  LIST
  NUMBER
  WEIGHTS
  BANDS
}

model Config {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  group          String
  type           ConfigType
  valueJson      Json
  label          String
  description    String        @default("")
  isSystem       Boolean       @default(false)
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organisationId, key])
  @@index([key])
}

// ─── Tender Pipeline ──────────────────────────────────────────────────────────
// Status/outcome/winProbabilityText/bidDecision/intent are free-text columns
// validated at the Zod layer against the Config registry (tender.statusList,
// tender.outcomeList, tender.winProbWeights, etc.) rather than Prisma enums,
// so an admin can add/rename options without a migration (CONFIG NOT CODE).

model Client {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  status         String       @default("Pricing")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts ClientContact[]
  tenders  Tender[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  mobile    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenders Tender[]

  @@unique([clientId, name])
  @@index([clientId])
}

model Supplier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trade          String
  company        String
  contact        String?
  email          String?
  phone          String?
  comments       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, company, contact])
  @@index([organisationId, trade])
}

model Tender {
  id                    String         @id @default(cuid())
  organisationId        String
  organisation          Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectName           String
  address               String?
  status                String
  received              DateTime?
  due                   DateTime?
  submitted             DateTime?
  value                 Float          @default(0)
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id])
  contactId             String?
  contact               ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  winProbabilityText    String
  winProbabilityNumeric Float          @default(0)
  bidDecision           String
  intent                String
  reason                String?
  outcome               String?
  winningBid            Float?
  winningCo             String?
  priceDeltaPct         Float?
  valueBand             String
  year                  Int
  quarter               String
  marginPct             Float?
  tenderDurationDays    Int?
  expectedStart         DateTime?
  expectedEnd           DateTime?
  expectedLabour        Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([organisationId, projectName, clientId])
  @@index([organisationId, status])
  @@index([organisationId, clientId])
  @@index([organisationId, due])
  @@index([organisationId, outcome])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
