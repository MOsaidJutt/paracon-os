generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

model Organisation {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  primaryColor      String?  @default("#B08D57")
  isActive          Boolean  @default(true)
  // Legal entity printed on every generated document (CLAUDE.md rule 14) —
  // config, not a code constant, so a future white-label tenant carries its
  // own correct entity instead of Paracon's. Seeded for Paracon with the
  // CURRENT ABN (80 317 795 082) — the legacy templates in source data still
  // carry the retired ABN (42 166 362 625); this is the one place it's fixed.
  legalName         String?
  abn               String?
  registeredAddress String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  aiSettings            AiSetting[]
  aiUsageLogs           AiUsageLog[]
  organisationModules   OrganisationModule[]
  auditLogs             AuditLog[]
  invites               Invite[]
  configs               Config[]
  clients               Client[]
  suppliers             Supplier[]
  prospects             Prospect[]
  tenders               Tender[]
  projects              Project[]
  programActivities     ProgramActivity[]
  milestones            Milestone[]
  workers               Worker[]
  compliance            Compliance[]
  skills                Skill[]
  workerLeave           WorkerLeave[]
  forecastSnapshot      ForecastSnapshot?
  storedFiles           StoredFile[]
  linkedDocuments       LinkedDocument[]
  importJobs            ImportJob[]
  estimateLineItems     EstimateLineItem[]
  documentTemplates     DocumentTemplate[]
  generatedDocuments    GeneratedDocument[]
  counters              Counter[]
  purchaseOrders        PurchaseOrder[]
  deliveries            Delivery[]
  supplierBills         SupplierBill[]
  variations            Variation[]
  progressClaims        ProgressClaim[]
  retentionReleases     RetentionRelease[]
  mailboxSetting        MailboxSetting?
  googleDriveConnection GoogleDriveConnection?
  allocations           Allocation[]
  dailySiteUpdates      DailySiteUpdate[]
  issues                Issue[]
  staffScores           StaffScore[]
  productivityRecords   ProductivityRecord[]
  dependencies          Dependency[]
  delayRecords          DelayRecord[]
  baselines             Baseline[]
  dashboardLayouts      DashboardLayout[]
  userPreferences       UserPreference[]
  checklistTicks        KpiChecklistTick[]
}

// ─── Documents & Templates engine ────────────────────────────────────────────
// DocumentTemplate holds each org's reusable generation config (scope-builder
// library, qualifications boilerplate, PDF colour tokens) — CONFIG NOT CODE,
// edited from an admin screen, never hard-coded in the PDF/XLSX generators.
// Counter gives atomic per-org sequence numbers, keyed by a scope string (e.g.
// "VARIATION:<projectId>", "PROGRESS_CLAIM:<projectId>", "TENDER_LETTER:<tenderId>")
// so VQ-## / Claim # reset per project while staying race-safe under concurrent
// generation requests (single upsert+increment is one atomic SQL statement).
// GeneratedDocument snapshots the exact data used for one generated
// PDF+XLSX pair so a previously-issued document never silently changes if an
// org's template config or a tender/project's fields are edited afterwards;
// "Regenerate" creates a NEW version with a fresh snapshot under the same number.

enum DocumentTemplateType {
  TENDER_LETTER
  VARIATION
  PROGRESS_CLAIM
  SWMS
}

model DocumentTemplate {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type           DocumentTemplateType
  configJson     Json
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organisationId, type])
}

// status is free-text validated against Config (document.generatedStatusList),
// mirroring Tender.status/Project.status — added because the source Drive
// folders encode a variation's withdrawn state only in the folder name
// (intake notes: "VQ-10 ... (WITHDRAWN)"); here it's a real field instead.
model GeneratedDocument {
  id               String               @id @default(cuid())
  organisationId   String
  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type             DocumentTemplateType
  projectId        String?
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenderId         String?
  tender           Tender?              @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  number           String
  version          Int                  @default(1)
  dataSnapshotJson Json
  pdfFileId        String?
  pdfFile          StoredFile?          @relation("GeneratedDocumentPdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  xlsxFileId       String?
  xlsxFile         StoredFile?          @relation("GeneratedDocumentXlsx", fields: [xlsxFileId], references: [id], onDelete: SetNull)
  status           String               @default("Issued")
  createdByUserId  String?
  createdBy        User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  versions      GeneratedDocumentVersion[]
  variation     Variation?
  progressClaim ProgressClaim?

  @@index([organisationId, projectId])
  @@index([organisationId, tenderId])
  @@index([organisationId, type])
}

// Append-only history of every version a "Regenerate" superseded — mirrors
// StoredFileVersion's pattern. The GeneratedDocument row above always holds
// the CURRENT version's snapshot + files.
model GeneratedDocumentVersion {
  id                  String            @id @default(cuid())
  generatedDocumentId String
  generatedDocument   GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  version             Int
  dataSnapshotJson    Json
  pdfFileId           String?
  xlsxFileId          String?
  createdAt           DateTime          @default(now())

  @@index([generatedDocumentId])
}

model Counter {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  scope          String
  value          Int          @default(0)

  @@unique([organisationId, scope])
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  hashedPassword String
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditLogs                       AuditLog[]
  sentInvites                     Invite[]
  pmProjects                      Project[]               @relation("ProjectPm")
  storedFiles                     StoredFile[]
  storedFileVersions              StoredFileVersion[]
  linkedDocuments                 LinkedDocument[]
  importJobs                      ImportJob[]
  generatedDocuments              GeneratedDocument[]
  purchaseOrdersCreated           PurchaseOrder[]
  supplierBillDecisions           SupplierBill[]
  variationDecisions              Variation[]
  progressClaimDecisions          ProgressClaim[]
  retentionReleasesRecorded       RetentionRelease[]
  allocationsCreated              Allocation[]
  foremanProjects                 Project[]               @relation("ProjectForeman")
  dailySiteUpdatesAsForeman       DailySiteUpdate[]       @relation("DailySiteUpdateForeman")
  issuesRaised                    Issue[]                 @relation("IssueRaisedBy")
  staffScoresAssessed             StaffScore[]            @relation("StaffScoreAssessedBy")
  delayRecordsChanged             DelayRecord[]
  baselinesSaved                  Baseline[]
  dashboardLayouts                DashboardLayout[]
  googleDriveConnectionsConnected GoogleDriveConnection[]
  preferences                     UserPreference[]
  checklistTicks                  KpiChecklistTick[]

  @@unique([organisationId, email])
  @@index([roleId])
}

/// Arbitrary per-user preference, keyed by a short slug. Holds the
/// Simplified/Full view mode ("view.mode") and the simplified dashboard's
/// chosen KPI ring slots ("dashboard.simple.rings"). Deliberately generic —
/// a new per-user preference is a new key, not a new column. Distinct from
/// DashboardLayout, which owns widget order/visibility only.
model UserPreference {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  valueJson      Json
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, userId, key])
  @@index([organisationId])
}

/// One row per (user, checklist item, period) the user has ticked. The items
/// themselves are config, not code — they live in the "dashboard.checklist.items"
/// Config row and are editable from the admin settings registry, so adding a
/// daily/weekly check never needs a migration. `periodKey` is the tick's
/// bucket: "2026-07-25" for a DAILY item, "2026-W30" for a WEEKLY one, so a
/// tick naturally lapses when the period rolls over.
model KpiChecklistTick {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey        String
  periodKey      String
  tickedAt       DateTime     @default(now())

  @@unique([organisationId, userId, itemKey, periodKey])
  @@index([organisationId, userId, periodKey])
}

/// Per-user, per-dashboard widget order/visibility — the Xero-style "edit
/// dashboard" preference. Config, not code: defaults live in
/// lib/dashboard/widget-registry.ts and this table only stores a user's
/// override once they customise.
model DashboardLayout {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboardKey   String
  widgets        Json
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, userId, dashboardKey])
  @@index([organisationId])
}

model Role {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users           User[]
  rolePermissions RolePermission[]
  invites         Invite[]

  @@unique([organisationId, slug])
}

model Permission {
  id          String @id @default(cuid())
  slug        String @unique
  group       String
  label       String
  description String @default("")

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invite {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email           String
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  invitedByUserId String
  invitedBy       User         @relation(fields: [invitedByUserId], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([organisationId, email])
  @@index([roleId])
}

// ─── AI Configuration ─────────────────────────────────────────────────────────

enum AiScope {
  GLOBAL
  ORG
  FEATURE
}

model AiSetting {
  id                 String        @id @default(cuid())
  scope              AiScope       @default(GLOBAL)
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  feature            String?
  provider           String        @default("openai")
  model              String        @default("gpt-4o-mini")
  apiKeyEncrypted    String
  baseUrl            String?
  temperature        Float         @default(0.7)
  maxTokens          Int           @default(2000)
  enabled            Boolean       @default(true)
  monthlySpendCapUsd Float?
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organisationId])
  @@index([scope, organisationId, feature])
}

model AiUsageLog {
  id               String        @id @default(cuid())
  organisationId   String?
  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  feature          String
  provider         String
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  costEstimateUsd  Float         @default(0)
  latencyMs        Int           @default(0)
  success          Boolean       @default(true)
  error            String?
  createdAt        DateTime      @default(now())

  @@index([organisationId])
  @@index([createdAt])
}

// ─── Modules / Feature Flags ─────────────────────────────────────────────────

model Module {
  id               String  @id @default(cuid())
  slug             String  @unique
  label            String
  description      String  @default("")
  enabledByDefault Boolean @default(true)
  isSystem         Boolean @default(false)
  sortOrder        Int     @default(0)

  organisationModules OrganisationModule[]
}

model OrganisationModule {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)

  @@id([organisationId, moduleId])
}

// ─── Settings Registry ───────────────────────────────────────────────────────

enum ConfigType {
  LIST
  NUMBER
  WEIGHTS
  BANDS
  TEXT
  METRICS
  // A list of {key, label, cadence} rows — the simplified dashboard's
  // daily/weekly KPI checklist. Admin-editable so adding a check is a settings
  // change, never a migration.
  CHECKLIST
}

model Config {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  group          String
  type           ConfigType
  valueJson      Json
  label          String
  description    String        @default("")
  isSystem       Boolean       @default(false)
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organisationId, key])
  @@index([key])
}

// ─── Tender Pipeline ──────────────────────────────────────────────────────────
// Status/outcome/winProbabilityText/bidDecision/intent are free-text columns
// validated at the Zod layer against the Config registry (tender.statusList,
// tender.outcomeList, tender.winProbWeights, etc.) rather than Prisma enums,
// so an admin can add/rename options without a migration (CONFIG NOT CODE).

model Client {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  status         String       @default("Pricing")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts ClientContact[]
  tenders  Tender[]
  projects Project[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  mobile    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenders Tender[]

  @@unique([clientId, name])
  @@index([clientId])
}

model Supplier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trade          String
  company        String
  contact        String?
  email          String?
  phone          String?
  comments       String?
  // "Supplier" (materials/hire) or "Subcontractor" (trade labour) — same
  // record shape either way (trade/company/contact), just a different
  // category in the Contacts directory (config-driven, supplier.kindList).
  kind           String       @default("Supplier")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
  supplierBills  SupplierBill[]
  performance    SupplierPerformance?

  @@unique([organisationId, company, contact])
  @@index([organisationId, trade])
  @@index([organisationId, kind])
}

// Same four-dimension rating as WorkerPerformance — subcontracting companies
// get rated the same way individual workers do, not just tracked as a contact.
model SupplierPerformance {
  id           String   @id @default(cuid())
  supplierId   String   @unique
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quality      Float    @default(0)
  reliability  Float    @default(0)
  productivity Float    @default(0)
  safety       Float    @default(0)
  updatedAt    DateTime @updatedAt
}

model Tender {
  id                    String         @id @default(cuid())
  organisationId        String
  organisation          Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  // Auto-numbered once at creation (incl. on prospect conversion) via the
  // Counter model — same "TENDER:<organisationId>" scope pattern as PO/VQ/claim
  // numbering (lib/tenders/numbering.ts), prefix/padding from tender.numberPrefix
  // / tender.numberPadding config. Never renumbered on edit. Nullable only
  // because it was backfilled onto pre-existing rows (received-date order,
  // oldest = T001) rather than being present from the first migration.
  code                  String?        @unique
  projectName           String
  address               String?
  status                String
  received              DateTime?
  due                   DateTime?
  submitted             DateTime?
  value                 Float          @default(0)
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id])
  contactId             String?
  contact               ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  winProbabilityText    String
  winProbabilityNumeric Float          @default(0)
  bidDecision           String
  intent                String
  reason                String?
  outcome               String?
  winningBid            Float?
  winningCo             String?
  priceDeltaPct         Float?
  valueBand             String
  year                  Int
  quarter               String
  marginPct             Float?
  tenderDurationDays    Int?
  expectedStart         DateTime?
  expectedEnd           DateTime?
  expectedLabour        Json?
  // [{ name: "Partitions", contractValue: number }] — the trade-package list +
  // sell value used by the Tender Letter's TENDER PRICE rows. Per-project/
  // tender custom list (intake notes confirm Partitions/Doors/Ceiling is not a
  // fixed global enum), defaulted from document.defaultTradePackageList and
  // carried into Project.tradePackages on "Won" conversion (enter once).
  tradePackages         Json?
  // Cached id of this tender's Drive folder (lazily created on first Drive
  // upload/link, under the org's GoogleDriveConnection.rootFolderId) — avoids
  // a Drive API round-trip + folder-search on every subsequent upload.
  driveFolderId         String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project  Project?
  prospect Prospect?

  storedFiles        StoredFile[]
  linkedDocuments    LinkedDocument[]
  estimateLineItems  EstimateLineItem[]
  generatedDocuments GeneratedDocument[]

  @@unique([organisationId, projectName, clientId])
  @@index([organisationId, status])
  @@index([organisationId, clientId])
  @@index([organisationId, due])
  @@index([organisationId, outcome])
}

// ─── Prospects / CRM (Phase 13) ──────────────────────────────────────────────
// Lightweight pre-tender leads list (cold → warm). Converting creates (or
// reuses) a Client + ClientContact and a Tender, carrying the prospect's
// details over — enter once, same pattern as Tender → Project conversion.
model Prospect {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name              String
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  address           String?
  estimatedValue    Float?
  stage             String       @default("Cold")
  // The three fields the vision doc's CRM list called for that the original
  // Prospect model didn't carry (INTAKE_NOTES §2: Company, Contact,
  // Opportunity, Probability, Next Action). Probability is a whole percent
  // rather than a 0-1 fraction because it is typed by a person, not computed —
  // "40" is what an estimator writes down. nextAction is what turns this from a
  // list of leads into something that chases them.
  probability       Int?
  nextAction        String?
  nextActionDate    DateTime?
  notes             String?
  convertedTenderId String?      @unique
  convertedTender   Tender?      @relation(fields: [convertedTenderId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organisationId])
  @@index([organisationId, stage])
  @@index([organisationId, nextActionDate])
}

// ─── Projects & Construction Program ─────────────────────────────────────────
// Status/trade/milestoneType are free-text, validated at the Zod layer against
// the Config registry (project.statusList, activity.statusList,
// milestone.typeList, trade.capabilityList) rather than Prisma enums, mirroring
// the Tender pipeline's CONFIG NOT CODE approach.

model Project {
  id                  String       @id @default(cuid())
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                String
  code                String
  address             String?
  status              String
  value               Float        @default(0)
  startDate           DateTime
  endDate             DateTime
  clientId            String
  client              Client       @relation(fields: [clientId], references: [id])
  sourceTenderId      String?      @unique
  sourceTender        Tender?      @relation(fields: [sourceTenderId], references: [id])
  pmUserId            String?
  pmUser              User?        @relation("ProjectPm", fields: [pmUserId], references: [id])
  // One foreman per active site (org chart: "one per active site") — resolved
  // by /api/site/today so a foreman lands on their project with zero taps.
  foremanUserId       String?
  foremanUser         User?        @relation("ProjectForeman", fields: [foremanUserId], references: [id])
  // [{ name: "Partitions", contractValue: number }] — carried from the source
  // Tender on conversion (enter once); feeds the Progress Claim's CONTRACT
  // WORK rows and is editable on the project if the contract is varied.
  tradePackages       Json?
  // Internal budgeted COST (distinct from `value`, the client-facing contract
  // sell price) — the other half of cost-vs-budget/margin. Null until a PM
  // sets it; financials derivation treats a null budget as "not yet set"
  // rather than zero.
  costBudget          Float?
  // Saved column visibility/order for this project's schedule (Gantt + task
  // table) view — shared by anyone who opens the schedule, not per-user, per
  // the Buildpass reference ("saved per schedule"). Null means "use defaults".
  scheduleColumnsJson Json?
  // Cached id of this project's Drive folder — see Tender.driveFolderId.
  driveFolderId       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  activities ProgramActivity[]
  milestones Milestone[]

  storedFiles         StoredFile[]
  linkedDocuments     LinkedDocument[]
  estimateLineItems   EstimateLineItem[]
  generatedDocuments  GeneratedDocument[]
  purchaseOrders      PurchaseOrder[]
  deliveries          Delivery[]
  supplierBills       SupplierBill[]
  variations          Variation[]
  progressClaims      ProgressClaim[]
  retentionReleases   RetentionRelease[]
  allocations         Allocation[]
  dailySiteUpdates    DailySiteUpdate[]
  issues              Issue[]
  productivityRecords ProductivityRecord[]
  baselines           Baseline[]
  delayRecords        DelayRecord[]

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@index([organisationId, clientId])
  @@index([organisationId, pmUserId])
}

// parentId makes this a self-referencing tree (phases -> tasks -> sub-tasks,
// unlimited depth rather than a rigid 3-level enum) — the Scheduling & Gantt
// module's task hierarchy. isCritical/floatDays are now SERVER-COMPUTED ONLY
// by lib/schedule/critical-path.ts (never accepted from API input) — replaces
// the old manually-set flag now that real CPM dependency data exists.
// labourRequired is only meaningful on LEAF activities (no children); a
// parent/phase row's own labourRequired is ignored by
// lib/projects/calculations.ts#aggregateLabourDemand to avoid double-counting
// against the Phase 5 forecast engine.
model ProgramActivity {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         ProgramActivity?  @relation("ProgramActivityHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       ProgramActivity[] @relation("ProgramActivityHierarchy")
  // Manual sibling order within the same parent (drag-to-reorder in the task tree table).
  orderIndex     Int               @default(0)
  name           String
  trade          String
  // Free text, not a User FK: the person named here is as often a foreman,
  // lead carpenter or subcontractor foreman as an office User with a login,
  // and the client's own examples were trade-crew names, not account names.
  // Defaulted to the project's PM at creation (never blank), then editable
  // per activity from there.
  responsible    String?
  startDate      DateTime
  endDate        DateTime
  isCritical     Boolean           @default(false)
  // Total slack (days) before this activity would itself become critical — null until the
  // critical-path engine has run at least once over this project's dependency graph.
  floatDays      Int?
  // User-set "this is a key date" flag — DISTINCT from isCritical (which is
  // CPM-computed slack, not a business-significant date). deriveMilestones()
  // creates a project Milestone from any activity with isMilestone=true,
  // independent of whether that activity also happens to sit on the
  // (computed) critical path.
  isMilestone    Boolean           @default(false)
  milestoneType  String?
  status         String
  // Record<role, count> — crew size required per role each week this activity is active.
  labourRequired Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  milestones                Milestone[]
  taskProgress              TaskProgress[]
  dependenciesAsPredecessor Dependency[]   @relation("DependencyPredecessor")
  dependenciesAsSuccessor   Dependency[]   @relation("DependencySuccessor")
  delayRecords              DelayRecord[]

  @@index([organisationId])
  @@index([projectId, startDate])
  @@index([parentId])
}

// ─── Scheduling & Gantt (dependencies, delay tracking, baselines) ────────────
// Models a real-world dependency between two tasks in the SAME project's
// program (validated at the route layer, not by an FK, since predecessor and
// successor only need to share a projectId, not a direct relation to it).
// lagDays is signed: positive = lag (gap), negative = lead (overlap) — both
// screenshots 4's "Add lag or lead to any dependency" map onto one field.
enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

model Dependency {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  predecessorId  String
  predecessor    ProgramActivity @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId    String
  successor      ProgramActivity @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type           DependencyType  @default(FINISH_TO_START)
  lagDays        Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([predecessorId, successorId])
  @@index([organisationId])
  @@index([predecessorId])
  @@index([successorId])
}

// Structured, reportable record of every time a task slipped to a LATER date —
// the EOT/Notice-of-Delays evidence trail (FEEDBACK_NOTES §3). Distinct from
// the generic AuditLog (which still gets a mirroring entry too): this table is
// the queryable "how many slips, what caused them" source, with the cascade
// of every downstream task the push affected snapshotted at save time so the
// record stays meaningful even if those tasks change again later.
model DelayRecord {
  id                     String          @id @default(cuid())
  organisationId         String
  organisation           Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId              String
  project                Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId             String
  activity               ProgramActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  previousStartDate      DateTime
  previousEndDate        DateTime
  newStartDate           DateTime
  newEndDate             DateTime
  // Config-driven (schedule.delayReasonList) — Material Delay, Weather, Sub No Show, etc.
  reason                 String
  note                   String?
  // [{ activityId, name, previousStartDate, previousEndDate, newStartDate, newEndDate }]
  downstreamImpactedJson Json            @default("[]")
  changedByUserId        String?
  changedBy              User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime        @default(now())

  @@index([organisationId, projectId])
  @@index([activityId])
}

// One snapshot of every activity's dates at the moment a baseline was saved —
// backs Buildpass-style "compare current vs original plan" EOT evidence.
// activityId is a plain string (NOT an FK) so a baseline survives a task being
// later renamed or deleted; the Gantt overlay falls back to the snapshotted
// name/dates if the live task is gone.
model Baseline {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  note           String?
  savedByUserId  String?
  savedBy        User?        @relation(fields: [savedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  tasks BaselineTask[]

  @@index([organisationId, projectId])
}

model BaselineTask {
  id         String   @id @default(cuid())
  baselineId String
  baseline   Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  activityId String
  name       String
  parentId   String?
  trade      String
  startDate  DateTime
  endDate    DateTime

  @@index([baselineId])
}

model Milestone {
  id               String           @id @default(cuid())
  organisationId   String
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  date             DateTime
  milestoneType    String?
  // Set when this milestone was auto-derived from a critical ProgramActivity;
  // re-synced (deleted + recreated) whenever that activity's program changes.
  sourceActivityId String?          @unique
  sourceActivity   ProgramActivity? @relation(fields: [sourceActivityId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())

  @@index([organisationId])
  @@index([projectId, date])
}

// ─── Labour Intelligence ──────────────────────────────────────────────────────
// capability/employmentType/status/Compliance.type are free-text, validated at
// the Zod layer against the Config registry (trade.capabilityList,
// worker.employmentTypeList, worker.statusList, compliance.typeList), mirroring
// the Tender/Projects CONFIG NOT CODE approach. Worker.capability and
// ProgramActivity.trade intentionally share trade.capabilityList so the Phase 5
// demand/supply engine can match them without a translation layer.

model Worker {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  // Optional additional name fields — a worker's legal/primary name stays in
  // `name`; these are purely supplementary so nothing that already reads
  // `worker.name` needs to change.
  chineseName    String?
  alias          String?
  phone          String?
  photoUrl       String?
  capability     String
  employmentType String
  status         String       @default("Available")
  baseLocation   String?
  // Free-text notes on this worker — visas, preferences, incidents, anything
  // that doesn't fit a structured field. Single overwritable field, same
  // pattern as Supplier.comments.
  notes          String?
  // Decides eligibility for the monthly Staff Scorecard (foremen, lead
  // carpenters, etc.) — set by a Director/PM, not every worker is assessed.
  isKeyStaff     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  performance WorkerPerformance?
  compliance  Compliance[]
  skills      WorkerSkill[]
  leave       WorkerLeave[]
  storedFiles StoredFile[]
  allocations Allocation[]
  attendances Attendance[]
  staffScores StaffScore[]

  @@index([organisationId, capability])
  @@index([organisationId, status])
}

// Date-ranged leave, separate from Worker.status (a point-in-time label). The
// Phase 5 SUPPLY calculation nets a worker out of a week's supply if any
// WorkerLeave range overlaps that week.
model WorkerLeave {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
  @@index([workerId, startDate, endDate])
}

model WorkerPerformance {
  id           String   @id @default(cuid())
  workerId     String   @unique
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  quality      Float    @default(0)
  reliability  Float    @default(0)
  productivity Float    @default(0)
  safety       Float    @default(0)
  updatedAt    DateTime @updatedAt
}

// status is engine-derived (recomputeAllCompliance), never accepted from the client.
model Compliance {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type           String
  reference      String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  docUrl         String?
  status         String       @default("Valid")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId, status])
  @@index([workerId])
  @@index([expiryDate])
}

model Skill {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  workerSkills WorkerSkill[]

  @@unique([organisationId, name])
}

model WorkerSkill {
  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level    Int    @default(1)

  @@id([workerId, skillId])
}

// ─── Resource Planner / Allocation (Phase 9) ─────────────────────────────────
// One row = one worker committed to one project for one ISO week (Monday,
// matching lib/dates.ts startOfIsoWeek). Trade is intentionally NOT
// snapshotted here — it's read live via worker.capability, the same shared
// trade.capabilityList every other demand/supply source already keys off, so
// there's no second copy to drift. The unique constraint is the structural
// double-booking guard: a worker can hold at most one allocation per week,
// full stop, across any project — the service layer pre-checks this for a
// clean 409 instead of surfacing a raw constraint violation.
model Allocation {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workerId        String
  worker          Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  createdByUserId String?
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())

  @@unique([organisationId, workerId, weekStart])
  @@index([organisationId, projectId, weekStart])
  @@index([organisationId, workerId])
}

// ─── Foreman Mobile Daily Updates (Phase 10) ─────────────────────────────────
// One row per foreman per project per calendar day — the offline-tolerant
// single-confirm submission the mobile flow centres on. Resolved via
// get-or-create on [organisationId, projectId, foremanUserId, date] so photo
// uploads, issue raises and the final submit are each independent and
// replay-safe — none of them has to wait for another to exist first, which is
// what makes the client-side sync queue able to flush in any order once back
// online. submittedAt stays null while a resumed session is still mid-entry;
// it's set once the foreman taps the single confirm button (the vision doc's
// "Required: Crew Today, Progress" is enforced at the Zod layer, not here).

model DailySiteUpdate {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  foremanUserId  String
  foremanUser    User         @relation("DailySiteUpdateForeman", fields: [foremanUserId], references: [id])
  date           DateTime
  // Free-text daily note (vision doc's optional "Note" field — weather,
  // access issues, anything not captured by a tick or a photo).
  note           String?
  submittedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendance   Attendance[]
  taskProgress TaskProgress[]
  issues       Issue[]
  photos       StoredFile[]
  deliveries   Delivery[]

  @@unique([organisationId, projectId, foremanUserId, date])
  @@index([organisationId, projectId, date])
}

model Attendance {
  id                String          @id @default(cuid())
  dailySiteUpdateId String
  dailySiteUpdate   DailySiteUpdate @relation(fields: [dailySiteUpdateId], references: [id], onDelete: Cascade)
  workerId          String
  worker            Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  present           Boolean
  hours             Float?

  @@unique([dailySiteUpdateId, workerId])
  @@index([workerId])
}

model TaskProgress {
  id                String          @id @default(cuid())
  dailySiteUpdateId String
  dailySiteUpdate   DailySiteUpdate @relation(fields: [dailySiteUpdateId], references: [id], onDelete: Cascade)
  programActivityId String
  programActivity   ProgramActivity @relation(fields: [programActivityId], references: [id], onDelete: Cascade)
  status            String
  note              String?

  @@unique([dailySiteUpdateId, programActivityId])
  @@index([programActivityId])
}

// status/severity are free-text, validated at the Zod layer against Config
// (site.issueStatusList, site.issueSeverityList) — CONFIG NOT CODE, mirroring
// every other status field in this schema.
model Issue {
  id                String           @id @default(cuid())
  organisationId    String
  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailySiteUpdateId String?
  dailySiteUpdate   DailySiteUpdate? @relation(fields: [dailySiteUpdateId], references: [id], onDelete: SetNull)
  raisedByUserId    String?
  raisedBy          User?            @relation("IssueRaisedBy", fields: [raisedByUserId], references: [id], onDelete: SetNull)
  description       String
  severity          String
  status            String           @default("Open")
  // Client-generated dedupe key — a sync-queue replay (response lost,
  // retried after reconnect) never creates a duplicate issue. Same pattern as
  // SupplierBill.emailMessageId; multiple NULLs stay distinct.
  clientRef         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  photos StoredFile[]

  @@unique([organisationId, clientRef])
  @@index([organisationId, projectId])
  @@index([organisationId, status])
}

// ─── Forecast & Capacity ──────────────────────────────────────────────────────
// One row per org — a persisted cache of the last computed forecast, kept warm
// by the nightly/on-demand Inngest job and by future Action Centre alerts
// (Phase 12/13). The live UI always recomputes via lib/forecast on every read,
// so this snapshot is never the source of truth for what's on screen — only a
// warm cache for consumers that don't need second-by-second freshness.

model ForecastSnapshot {
  id              String       @id @default(cuid())
  organisationId  String       @unique
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  generatedAt     DateTime
  blockLengthDays Int
  weeksOut        Int
  matrixJson      Json
  heatmapJson     Json
  headroomJson    Json
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ─── Document Management (hybrid storage) ────────────────────────────────────
// category/kind are free-text, validated at the Zod layer against the Config
// registry (document.projectCategoryList, document.tenderCategoryList,
// document.linkedKindList), mirroring every other CONFIG NOT CODE list in this
// schema. StoredFile always holds the CURRENT version; StoredFileVersion is an
// append-only history of every version it superseded — old object keys are
// kept in storage, never deleted, only superseded.

model StoredFile {
  id                String           @id @default(cuid())
  organisationId    String
  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key               String
  name              String
  mime              String
  size              Int
  version           Int              @default(1)
  category          String
  // Free-text photo caption (Site Photo category) — null for every other
  // category. Generic rather than a separate SitePhoto model: a site photo is
  // just a StoredFile, per the hybrid storage section's "store once" rule.
  caption           String?
  // Client-generated dedupe key (mobile sync-queue retries) — same pattern as
  // SupplierBill.emailMessageId; multiple NULLs stay distinct under the
  // unique index, so every non-Site-Photo upload is unaffected.
  clientRef         String?
  previewKey        String?
  tagsJson          Json             @default("[]")
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenderId          String?
  tender            Tender?          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  workerId          String?
  worker            Worker?          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dailySiteUpdateId String?
  dailySiteUpdate   DailySiteUpdate? @relation(fields: [dailySiteUpdateId], references: [id], onDelete: Cascade)
  issueId           String?
  issue             Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedByUserId  String?
  uploadedBy        User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  versions                      StoredFileVersion[]
  generatedDocumentPdfOf        GeneratedDocument[] @relation("GeneratedDocumentPdf")
  generatedDocumentXlsxOf       GeneratedDocument[] @relation("GeneratedDocumentXlsx")
  supplierBills                 SupplierBill[]
  progressClaimStatDeclarations ProgressClaim[]

  @@unique([organisationId, clientRef])
  @@index([organisationId, projectId])
  @@index([organisationId, tenderId])
  @@index([organisationId, workerId])
  @@index([organisationId, category])
  @@index([organisationId, dailySiteUpdateId])
  @@index([organisationId, issueId])
}

model StoredFileVersion {
  id               String     @id @default(cuid())
  storedFileId     String
  storedFile       StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Cascade)
  key              String
  version          Int
  size             Int
  mime             String
  uploadedByUserId String?
  uploadedBy       User?      @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())

  @@index([storedFileId])
}

model LinkedDocument {
  id                  String       @id @default(cuid())
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                String
  // Drive's webViewLink — opens straight to the file/folder in Drive's own
  // viewer, no folder-hunting. Still the field name `driveUrl` for backward
  // compatibility with rows created before the live integration shipped.
  driveUrl            String
  kind                String
  // How this row was created. "manual" (default) = the original pasted-URL
  // flow, kept as a fallback for links OneParacon's own OAuth grant can't
  // browse (e.g. a client's external share). "upload" = uploaded to Drive
  // from inside OneParacon. "picker" = selected from Drive via the Picker
  // widget without leaving the app.
  source              String       @default("manual")
  driveFileId         String?
  mimeType            String?
  size                Int?
  thumbnailLink       String?
  parentDriveFolderId String?
  projectId           String?
  project             Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenderId            String?
  tender              Tender?      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  addedByUserId       String?
  addedBy             User?        @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organisationId, projectId])
  @@index([organisationId, tenderId])
  @@index([organisationId, driveFileId])
}

// One Google account connected per org (admin.settings), least-privileged
// `drive.file` scope only — OneParacon can only see/manage files and folders
// it creates or that a user explicitly picks via the Picker widget, never the
// org's whole Drive. refreshTokenEncrypted follows the same AES-256-GCM
// pattern as AiSetting.apiKeyEncrypted / MailboxSetting.passwordEncrypted
// (lib/crypto.ts); a short-lived access token is minted on demand and never
// persisted. This is CLAUDE.md's one deliberate exception to rule 11
// (SELF-CONTAINED) — large CAD/drawing sets stay in Drive by explicit client
// instruction; everything else still lives in our own storage.
model GoogleDriveConnection {
  id                    String       @id @default(cuid())
  organisationId        String       @unique
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  googleAccountEmail    String
  refreshTokenEncrypted String
  // The "OneParacon Documents" folder created in the connected account's
  // Drive on first connect — every project/tender folder is created as a
  // child of this one, so the integration never touches anything outside a
  // folder tree it created itself.
  rootFolderId          String?
  enabled               Boolean      @default(true)
  connectedByUserId     String?
  connectedBy           User?        @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
  lastTestedAt          DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

// ─── Import Centre ────────────────────────────────────────────────────────────
// importerKey identifies which pluggable importer (lib/import/registry.ts) ran.
// contentHash + importerKey + organisationId is the idempotency key: committing
// the same file twice for the same importer short-circuits to the prior report
// instead of re-applying side effects. ImportJobStatus is an internal system
// status (like AiScope/ConfigType above), not business-config data, so it's a
// real enum rather than a Config-backed free-text list.

enum ImportJobStatus {
  PENDING
  COMMITTED
  FAILED
}

model ImportJob {
  id              String          @id @default(cuid())
  organisationId  String
  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importerKey     String
  fileName        String
  contentHash     String
  stagedKey       String?
  status          ImportJobStatus @default(PENDING)
  summaryJson     Json?
  createdByUserId String?
  createdBy       User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  estimateLineItems EstimateLineItem[]

  @@index([organisationId, importerKey, contentHash])
}

model EstimateLineItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenderId       String?
  tender         Tender?      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float
  unit           String
  unitRate       Float?
  amount         Float?
  remarks        String?
  source         String       @default("zztakeoff")
  importJobId    String?
  importJob      ImportJob?   @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organisationId, projectId])
  @@index([organisationId, tenderId])
}

// ─── Project Financials & Invoice Review (Phase 8) ───────────────────────────
// Replaces the Dropbox for-review/approved/reconcile folders + the make.com
// sorting chain with an in-app review pipeline. EzzyBills + Xero stay the
// downstream bookkeeping tools exactly as today — OneParacon ingests incoming
// bills, runs the PM's existing four-point checklist, and hands an APPROVED
// bill onward (export, or the accounts team's existing manual forward into
// EzzyBills); it never calls either API live (CLAUDE.md rule 11).

model PurchaseOrder {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Per-project sequential, e.g. "PO-01" (lib/finance/numbering.ts), mirroring
  // the Phase 7 VQ-##/Claim # Counter-backed scheme.
  number          String
  // [{ description, quantity, unit, unitRate, amount }] — free-form, like
  // EstimateLineItem; a PO rarely needs full take-off rigour.
  itemsJson       Json         @default("[]")
  value           Float        @default(0)
  expectedDate    DateTime?
  status          String       @default("Draft")
  createdByUserId String?
  createdBy       User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  deliveries Delivery[]
  bills      SupplierBill[]

  @@unique([organisationId, projectId, number])
  @@index([organisationId, projectId])
  @@index([organisationId, status])
}

model Delivery {
  id                String           @id @default(cuid())
  organisationId    String
  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional — small ad-hoc deliveries don't always have a formal PO, per the
  // intake notes' simple Procurement register (Supplier/Material/Project/
  // Required Date/Ordered/Delivered).
  poId              String?
  po                PurchaseOrder?   @relation(fields: [poId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  itemsJson         Json             @default("[]")
  expectedDate      DateTime?
  deliveredDate     DateTime?
  status            String           @default("Pending")
  // Traceability only — which foreman daily update confirmed/flagged this
  // delivery, if any. Confirming via the mobile flow just writes status +
  // deliveredDate through the existing Phase 8 delivery service; this is the
  // audit trail back to the update that triggered it, not a second source of
  // truth for delivery state.
  dailySiteUpdateId String?
  dailySiteUpdate   DailySiteUpdate? @relation(fields: [dailySiteUpdateId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organisationId, projectId])
  @@index([organisationId, poId])
  @@index([organisationId, status])
  @@index([organisationId, dailySiteUpdateId])
}

// status is free-text, validated against finance.bill.statusList (CONFIG NOT
// CODE, mirroring every other status field in this schema). allocationStatus
// is the auto-pull mailbox watcher's routing flag: Unallocated bills surface
// in the org-wide tray for the accounts person to assign in one click.
model SupplierBill {
  id                   String         @id @default(cuid())
  organisationId       String
  organisation         Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplierId           String?
  supplier             Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Raw sender/extracted supplier name, kept even after a Supplier match is
  // made, so the original email evidence is never lost.
  supplierNameRaw      String?
  poId                 String?
  po                   PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  billFileId           String
  billFile             StoredFile     @relation(fields: [billFileId], references: [id], onDelete: Cascade)
  invoiceNumber        String?
  invoiceDate          DateTime?
  amountExGst          Float          @default(0)
  gstAmount            Float          @default(0)
  amountIncGst         Float          @default(0)
  // The P##-#### text actually found (mailbox watcher or manual entry) —
  // kept regardless of whether it resolved to a real project, as an audit
  // trail for why a bill did/didn't auto-allocate.
  jobNumberRaw         String?
  allocationStatus     String         @default("Unallocated")
  status               String         @default("Received")
  orderedConfirmed     Boolean        @default(false)
  receivedConfirmed    Boolean        @default(false)
  quantityConfirmed    Boolean        @default(false)
  priceConfirmed       Boolean        @default(false)
  reviewNote           String?
  lastDecisionByUserId String?
  lastDecisionBy       User?          @relation(fields: [lastDecisionByUserId], references: [id], onDelete: SetNull)
  lastDecisionAt       DateTime?
  source               String         @default("Manual")
  // Dedupe key for the IMAP watcher — re-polling never double-ingests the
  // same message. Null (manual bills) doesn't collide: Postgres/SQLite treat
  // multiple NULLs in a unique index as distinct.
  emailMessageId       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([organisationId, emailMessageId])
  @@index([organisationId, projectId])
  @@index([organisationId, allocationStatus])
  @@index([organisationId, status])
  @@index([organisationId, poId])
}

// Thin commercial wrapper around a Phase-7 GeneratedDocument(type=VARIATION):
// tracks the register's Submitted/Approved/Outstanding status and contract
// value contribution, kept separate from the document's own Issued/Withdrawn/
// Superseded lifecycle status so the two concerns never collide.
model Variation {
  id                  String            @id @default(cuid())
  organisationId      String
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedDocumentId String            @unique
  generatedDocument   GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  number              String
  value               Float
  status              String            @default("Submitted")
  decidedByUserId     String?
  decidedBy           User?             @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt           DateTime?
  note                String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organisationId, projectId])
  @@index([organisationId, status])
}

// Thin commercial wrapper around a Phase-7 GeneratedDocument(type=PROGRESS_CLAIM):
// the internal review/approve/issue/certify/pay pipeline + retention
// tracking the document-generation step itself doesn't know about.
// retentionPct/retentionHeld are snapshotted at decision time so a later
// admin change to the retention config never reshapes a past claim.
model ProgressClaim {
  id                    String            @id @default(cuid())
  organisationId        String
  organisation          Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId             String
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedDocumentId   String            @unique
  generatedDocument     GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  number                String
  claimedAmountExGst    Float
  claimedAmountIncGst   Float
  retentionPct          Float             @default(0)
  retentionHeld         Float             @default(0)
  statDeclarationFileId String?
  statDeclarationFile   StoredFile?       @relation(fields: [statDeclarationFileId], references: [id], onDelete: SetNull)
  status                String            @default("Draft")
  certifiedAmount       Float?
  certifiedAt           DateTime?
  paidAmount            Float             @default(0)
  paidAt                DateTime?
  decidedByUserId       String?
  decidedBy             User?             @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt             DateTime?
  issuedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([organisationId, projectId])
  @@index([organisationId, status])
}

// Append-only ledger of retention released back to the supplier/client side
// (Practical Completion releases half the 5% cap; Final releases the rest
// post-defects-liability) — lets retention-held-to-date always be derived as
// sum(claims.retentionHeld) - sum(releases.amount) rather than a single
// mutable scalar, so staged/partial PC releases are representable.
model RetentionRelease {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount           Float
  type             String       @default("PracticalCompletion")
  note             String?
  recordedByUserId String?
  recordedBy       User?        @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  releasedAt       DateTime     @default(now())

  @@index([organisationId, projectId])
}

// One mailbox per org — the "auto-pull" accounts inbox the bill watcher
// polls. password is encrypted at rest via lib/crypto.ts (same pattern as
// AiSetting.apiKeyEncrypted); never logged or returned to the client.
model MailboxSetting {
  id                String       @id @default(cuid())
  organisationId    String       @unique
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  host              String
  port              Int          @default(993)
  username          String
  passwordEncrypted String
  useTls            Boolean      @default(true)
  folder            String       @default("INBOX")
  enabled           Boolean      @default(false)
  lastSeenUid       Int          @default(0)
  lastPolledAt      DateTime?
  updatedBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ─── Productivity & Staff Scorecard (Phase 11) ───────────────────────────────
// trade is free-text from the shared trade.capabilityList vocabulary (same as
// Worker.capability/ProgramActivity.trade) — one row per project+trade+month,
// recomputed by lib/scorecard/productivity-service.ts from ProgramActivity
// (planned hours) and Attendance (actual hours). plannedHoursShare is this
// trade's share of the PROJECT's total planned hours that month; costPerHour
// allocates Project.value by that share and divides by actualHours — an
// approximate $/labour-hour benchmark (NOT a literal $/m² rate, since the
// trade-package list and worker capability list are different vocabularies
// per the intake notes' gap #6), used to feed historical $/hour-by-trade back
// into estimating a new tender's expected labour.
model ProductivityRecord {
  id                String       @id @default(cuid())
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trade             String
  periodStart       DateTime
  periodEnd         DateTime
  plannedHours      Float        @default(0)
  actualHours       Float        @default(0)
  outputRatio       Float?
  attendanceDays    Int          @default(0)
  expectedDays      Int          @default(0)
  reliabilityPct    Float?
  plannedHoursShare Float?
  costPerHour       Float?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organisationId, projectId, trade, periodStart])
  @@index([organisationId, trade, periodStart])
  @@index([organisationId, projectId, periodStart])
}

// One row per key-staff worker per calendar month — metricScoresJson holds
// the raw 0..scaleMax score per Config-driven metric key (scorecard.metrics);
// overallScore is the weighted result snapshotted at save time so a later
// admin change to the metric weights never reshapes a past month's score
// (mirrors RetentionRelease/ProgressClaim's snapshot-at-decision pattern).
// lockedAt makes the month immutable (lib/scorecard/calc.ts#assertScoreEditable);
// history (one row per period, never overwritten across months) is the seam
// a future incentive program reads from — no payout logic here.
model StaffScore {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workerId         String
  worker           Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  period           DateTime
  metricScoresJson Json
  overallScore     Float        @default(0)
  assessedByUserId String?
  assessedBy       User?        @relation("StaffScoreAssessedBy", fields: [assessedByUserId], references: [id], onDelete: SetNull)
  lockedAt         DateTime?
  note             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organisationId, workerId, period])
  @@index([organisationId, period])
  @@index([workerId])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
