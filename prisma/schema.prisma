generator client {
  provider = "prisma-client-js"
}

// TEMPORARY: swapped to sqlite for a local client demo with zero external setup.
// Swap back to postgresql + DATABASE_URL_UNPOOLED before continuing real development.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

model Organisation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String?  @default("#B08D57")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  roles               Role[]
  aiSettings          AiSetting[]
  aiUsageLogs         AiUsageLog[]
  organisationModules OrganisationModule[]
  auditLogs           AuditLog[]
  invites             Invite[]
  configs             Config[]
  clients             Client[]
  suppliers           Supplier[]
  tenders             Tender[]
  projects            Project[]
  programActivities   ProgramActivity[]
  milestones          Milestone[]
  workers             Worker[]
  compliance          Compliance[]
  skills              Skill[]
  workerLeave         WorkerLeave[]
  forecastSnapshot    ForecastSnapshot?
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  hashedPassword String
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditLogs    AuditLog[]
  sentInvites  Invite[]
  pmProjects   Project[]

  @@unique([organisationId, email])
  @@index([roleId])
}

model Role {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users           User[]
  rolePermissions RolePermission[]
  invites         Invite[]

  @@unique([organisationId, slug])
}

model Permission {
  id          String @id @default(cuid())
  slug        String @unique
  group       String
  label       String
  description String @default("")

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Invite {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email           String
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  invitedByUserId String
  invitedBy       User         @relation(fields: [invitedByUserId], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([organisationId, email])
  @@index([roleId])
}

// ─── AI Configuration ─────────────────────────────────────────────────────────

enum AiScope {
  GLOBAL
  ORG
  FEATURE
}

model AiSetting {
  id                 String        @id @default(cuid())
  scope              AiScope       @default(GLOBAL)
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  feature            String?
  provider           String        @default("openai")
  model              String        @default("gpt-4o-mini")
  apiKeyEncrypted    String
  baseUrl            String?
  temperature        Float         @default(0.7)
  maxTokens          Int           @default(2000)
  enabled            Boolean       @default(true)
  monthlySpendCapUsd Float?
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organisationId])
  @@index([scope, organisationId, feature])
}

model AiUsageLog {
  id               String        @id @default(cuid())
  organisationId   String?
  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  feature          String
  provider         String
  model            String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  costEstimateUsd  Float         @default(0)
  latencyMs        Int           @default(0)
  success          Boolean       @default(true)
  error            String?
  createdAt        DateTime      @default(now())

  @@index([organisationId])
  @@index([createdAt])
}

// ─── Modules / Feature Flags ─────────────────────────────────────────────────

model Module {
  id               String  @id @default(cuid())
  slug             String  @unique
  label            String
  description      String  @default("")
  enabledByDefault Boolean @default(true)
  isSystem         Boolean @default(false)
  sortOrder        Int     @default(0)

  organisationModules OrganisationModule[]
}

model OrganisationModule {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  moduleId       String
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)

  @@id([organisationId, moduleId])
}

// ─── Settings Registry ───────────────────────────────────────────────────────

enum ConfigType {
  LIST
  NUMBER
  WEIGHTS
  BANDS
}

model Config {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  group          String
  type           ConfigType
  valueJson      Json
  label          String
  description    String        @default("")
  isSystem       Boolean       @default(false)
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organisationId, key])
  @@index([key])
}

// ─── Tender Pipeline ──────────────────────────────────────────────────────────
// Status/outcome/winProbabilityText/bidDecision/intent are free-text columns
// validated at the Zod layer against the Config registry (tender.statusList,
// tender.outcomeList, tender.winProbWeights, etc.) rather than Prisma enums,
// so an admin can add/rename options without a migration (CONFIG NOT CODE).

model Client {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  status         String       @default("Pricing")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts ClientContact[]
  tenders  Tender[]
  projects Project[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  mobile    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenders Tender[]

  @@unique([clientId, name])
  @@index([clientId])
}

model Supplier {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trade          String
  company        String
  contact        String?
  email          String?
  phone          String?
  comments       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, company, contact])
  @@index([organisationId, trade])
}

model Tender {
  id                    String         @id @default(cuid())
  organisationId        String
  organisation          Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectName           String
  address               String?
  status                String
  received              DateTime?
  due                   DateTime?
  submitted             DateTime?
  value                 Float          @default(0)
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id])
  contactId             String?
  contact               ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  winProbabilityText    String
  winProbabilityNumeric Float          @default(0)
  bidDecision           String
  intent                String
  reason                String?
  outcome               String?
  winningBid            Float?
  winningCo             String?
  priceDeltaPct         Float?
  valueBand             String
  year                  Int
  quarter               String
  marginPct             Float?
  tenderDurationDays    Int?
  expectedStart         DateTime?
  expectedEnd           DateTime?
  expectedLabour        Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project Project?

  @@unique([organisationId, projectName, clientId])
  @@index([organisationId, status])
  @@index([organisationId, clientId])
  @@index([organisationId, due])
  @@index([organisationId, outcome])
}

// ─── Projects & Construction Program ─────────────────────────────────────────
// Status/trade/milestoneType are free-text, validated at the Zod layer against
// the Config registry (project.statusList, activity.statusList,
// milestone.typeList, trade.capabilityList) rather than Prisma enums, mirroring
// the Tender pipeline's CONFIG NOT CODE approach.

model Project {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  status         String
  value          Float        @default(0)
  startDate      DateTime
  endDate        DateTime
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  sourceTenderId String?      @unique
  sourceTender   Tender?      @relation(fields: [sourceTenderId], references: [id])
  pmUserId       String?
  pmUser         User?        @relation(fields: [pmUserId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities ProgramActivity[]
  milestones Milestone[]

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@index([organisationId, clientId])
}

model ProgramActivity {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  trade          String
  startDate      DateTime
  endDate        DateTime
  isCritical     Boolean      @default(false)
  milestoneType  String?
  status         String
  // Record<role, count> — crew size required per role each week this activity is active.
  labourRequired Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  milestones Milestone[]

  @@index([organisationId])
  @@index([projectId, startDate])
}

model Milestone {
  id               String           @id @default(cuid())
  organisationId   String
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  date             DateTime
  milestoneType    String?
  // Set when this milestone was auto-derived from a critical ProgramActivity;
  // re-synced (deleted + recreated) whenever that activity's program changes.
  sourceActivityId String?          @unique
  sourceActivity   ProgramActivity? @relation(fields: [sourceActivityId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())

  @@index([organisationId])
  @@index([projectId, date])
}

// ─── Labour Intelligence ──────────────────────────────────────────────────────
// capability/employmentType/status/Compliance.type are free-text, validated at
// the Zod layer against the Config registry (trade.capabilityList,
// worker.employmentTypeList, worker.statusList, compliance.typeList), mirroring
// the Tender/Projects CONFIG NOT CODE approach. Worker.capability and
// ProgramActivity.trade intentionally share trade.capabilityList so the Phase 5
// demand/supply engine can match them without a translation layer.

model Worker {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  photoUrl       String?
  capability     String
  employmentType String
  status         String       @default("Available")
  baseLocation   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  performance WorkerPerformance?
  compliance  Compliance[]
  skills      WorkerSkill[]
  leave       WorkerLeave[]

  @@index([organisationId, capability])
  @@index([organisationId, status])
}

// Date-ranged leave, separate from Worker.status (a point-in-time label). The
// Phase 5 SUPPLY calculation nets a worker out of a week's supply if any
// WorkerLeave range overlaps that week.
model WorkerLeave {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
  @@index([workerId, startDate, endDate])
}

model WorkerPerformance {
  id           String   @id @default(cuid())
  workerId     String   @unique
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  quality      Float    @default(0)
  reliability  Float    @default(0)
  productivity Float    @default(0)
  safety       Float    @default(0)
  updatedAt    DateTime @updatedAt
}

// status is engine-derived (recomputeAllCompliance), never accepted from the client.
model Compliance {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type           String
  reference      String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  docUrl         String?
  status         String       @default("Valid")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId, status])
  @@index([workerId])
  @@index([expiryDate])
}

model Skill {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  workerSkills WorkerSkill[]

  @@unique([organisationId, name])
}

model WorkerSkill {
  workerId String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level    Int    @default(1)

  @@id([workerId, skillId])
}

// ─── Forecast & Capacity ──────────────────────────────────────────────────────
// One row per org — a persisted cache of the last computed forecast, kept warm
// by the nightly/on-demand Inngest job and by future Action Centre alerts
// (Phase 12/13). The live UI always recomputes via lib/forecast on every read,
// so this snapshot is never the source of truth for what's on screen — only a
// warm cache for consumers that don't need second-by-second freshness.

model ForecastSnapshot {
  id              String       @id @default(cuid())
  organisationId  String       @unique
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  generatedAt     DateTime
  blockLengthDays Int
  weeksOut        Int
  matrixJson      Json
  heatmapJson     Json
  headroomJson    Json
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
